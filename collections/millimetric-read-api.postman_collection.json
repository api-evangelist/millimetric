                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "(Required) ISO 8601 timestamp (exclusive)."
                },
                {
                  "disabled": false,
                  "key": "event",
                  "value": "<string>",
                  "description": "Filter to one event name."
                },
                {
                  "disabled": false,
