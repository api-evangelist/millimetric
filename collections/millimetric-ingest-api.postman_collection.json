          "name": "Emit a single analytics event",
          "request": {
            "name": "Emit a single analytics event",
            "description": {
              "content": "Emit a single analytics event — the most common write endpoint. Requires an ingest-scope key (pk_* browser, origin-checked; or sk_* server). The server enriches every event with source/medium classification, geo, device, and a hashed IP before insert.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "track"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
