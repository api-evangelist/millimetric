        {
          "id": "3fc869ac-ca75-4e50-9f29-4d307c80f99c",
          "name": "GDPR delete for a user",
          "request": {
            "name": "GDPR delete for a user",
            "description": {
              "content": "Permanently delete every event for (project_id, user_id). Intended for GDPR / CCPA Right-to-be-Forgotten. sk_* keys only — pk_* is explicitly rejected to prevent a leaked browser key from wiping data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "forget"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
